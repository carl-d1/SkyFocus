{
  "name": "skyfocus",
  "productName": "SkyFocus",
  "version": "1.1.0",
  "description": "A flight-themed focus timer. Every focus session is a flight between real airports.",
  "author": "Carlos",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron .",
    "dist": "electron-builder --win portable nsis --x64 --publish never",
    "release": "electron-builder --win portable nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "au.com.hyetech.skyfocus",
    "productName": "SkyFocus",
    "copyright": "Copyright 2026 Carlos",
    "directories": {
      "output": "dist",
      "buildResources": "desktop/build"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "vendor/**/*",
      "desktop/**/*",
      "!desktop/build/**/*",
      "!**/*.map",
      "package.json",
      "!vendor/README.md"
    ],
    "asar": true,
    "win": {
      "icon": "desktop/build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkyFocus",
      "uninstallDisplayName": "SkyFocus",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "carl-d1",
        "repo": "SkyFocus",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carl-d1/SkyFocus.git"
  }
}
